# Optional: when set, buyer inquiries are emailed to info@bigmountn.com
RESEND_API_KEY=
# Optional verified sender, e.g. "Addis Hands <noreply@yourdomain.com>"
RESEND_FROM_EMAIL=

# Admin (/admin) — single shared password
ADMIN_PASSWORD=
# Secret used to sign the admin session cookie (use a long random string)
ADMIN_SESSION_SECRET=

# Google Analytics 4 (Realtime) — Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# News view counts (Upstash Redis free tier) — https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
